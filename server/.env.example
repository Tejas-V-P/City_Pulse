# ==============================================================================
# City Pulse Server - Environment Configuration Template
# (Do NOT commit real secrets or production credentials to source control)
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Strong random secret key for signing JWT tokens (e.g. 64-char hex string)
JWT_SECRET=your_jwt_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# MongoDB connection string (local mongod or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/city_pulse

# PostgreSQL (Optional)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cityevent_db
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=cityevent_db
PGPORT=5432

# Redis (Optional)
REDIS_URL=redis://127.0.0.1:6379

# Google Gemini API Key (Optional)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
