# Copy this file to .env for local development, or configure these as
# environment variables in your hosting platform (e.g. Render) for production.

PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or self-hosted). Required.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=Cluster0

# Comma-separated list of origins allowed to call this API in production.
# Set this to your deployed frontend URL, e.g. https://city-pulse.vercel.app
CLIENT_URL=http://localhost:5173

# LLM provider key used by the AI Event Assistant feature.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
